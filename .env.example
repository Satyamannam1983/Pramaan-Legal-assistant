# Copy to .env for local development. Never put real credentials in this file.
APP_ENV=development
APP_NAME=Pramaan API

# Host-run backend connection. Change only if your local MongoDB differs.
DATABASE_URL=mongodb://localhost:27017/pramaan
# Docker Compose overrides DATABASE_URL inside the API container with this service URL.
COMPOSE_DATABASE_URL=mongodb://db:27017/pramaan
DATABASE_NAME=pramaan
ATLAS_VECTOR_SEARCH=false

# Local browser origin. For a hosted frontend, replace with its exact origin.
CORS_ORIGINS=http://localhost:3000

# Stub output is deterministic development output, not legal analysis.
LLM_PROVIDER=stub
LLM_MODEL=placeholder
OPENAI_API_KEY=
OPENROUTER_API_KEY=
LLM_BASE_URL=
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=2048

EMBEDDING_PROVIDER=sentence_transformer
EMBEDDING_MODEL=intfloat/multilingual-e5-large
EMBEDDING_DIMENSION=1024
EMBEDDING_BATCH_SIZE=32

VECTOR_TOP_K=20
KEYWORD_TOP_K=20
RERANK_TOP_K=10
FINAL_TOP_K=5
VECTOR_WEIGHT=0.6
KEYWORD_WEIGHT=0.4
RRF_K=60
RERANKER_PROVIDER=
RERANKER_MODEL=

MAX_UPLOAD_SIZE_MB=25
MAX_REQUEST_BODY_MB=30
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
CHUNK_SIZE=1200
CHUNK_OVERLAP=150
LOG_LEVEL=INFO
